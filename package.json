{
  "name": "bugshot",
  "productName": "BugShot",
  "version": "0.5.0",
  "description": "安卓测试 Bug 截图与反馈记录工具（客户端 + 局域网共享服务端）",
  "main": "out/main/index.js",
  "author": "hui455",
  "license": "MIT",
  "repository": "github:hui455/test-android",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-server.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "fetch-adb": "node scripts/fetch-adb.mjs",
    "release-notes": "node scripts/release-notes.mjs out/release-notes.md",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "build:server": "node scripts/build-server.mjs",
    "serve": "node scripts/build-server.mjs && node out/server/bugshot-server.cjs --data ./data",
    "dev:server": "electron-vite dev --entry out/main/server-app.js",
    "dist:server": "npm run build && electron-builder --config electron-builder.server.yml"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^7.0.1",
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod": "^3.25.76"
  }
}
